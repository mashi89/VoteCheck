<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VoteCheckGUI.MainWindow"
        Title="VoteCheck (with Avalonia)"
        Width="1450" Height="650"
        MinWidth="700" MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="265"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Breadcrumb bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2"
                Background="#F0F4F8" BorderBrush="#C8D6E5" BorderThickness="0,0,0,1"
                Padding="10,5">
            <TextBlock x:Name="lblBreadcrumb"
                       Text="—"
                       FontSize="12"
                       Foreground="#4A6080"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Loading bar -->
        <ProgressBar x:Name="progressBar"
                     Grid.Row="1" Grid.ColumnSpan="2"
                     IsIndeterminate="True"
                     IsVisible="False"
                     Height="4"
                     Foreground="#4A90D9"
                     Background="Transparent"/>

        <!-- Left panel -->
        <DockPanel Grid.Row="2" Grid.Column="0" Margin="10,10,5,10" LastChildFill="False">

            <!-- Back / Reset buttons at the top -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16" DockPanel.Dock="Top">
                <Button x:Name="btnBack" Content="Back" Width="60"
                        Padding="4,2" Margin="0,0,4,0"
                        Click="btnBack_Click"/>
                <Button x:Name="btnReset" Content="Reset" Width="60"
                        Padding="4,2"
                        Click="btnReset_Click"/>
            </StackPanel>

            <!-- Find by date section -->
            <TextBlock Text="Find by date" Margin="0,0,0,2" DockPanel.Dock="Top"/>
            <TextBox x:Name="tbDate" Margin="0,0,0,4" DockPanel.Dock="Top"
                     KeyDown="tbDate_KeyDown"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20" DockPanel.Dock="Top">
                <Button x:Name="btnFindDate" Content="Find" Width="60" HorizontalAlignment="Left"
                        Padding="4,2" Margin="0,0,4,0"
                        Click="btnFindDate_Click"/>
                <Button x:Name="btnToday" Content="Today" Width="60" HorizontalAlignment="Left"
                        Padding="4,2"
                        Click="btnToday_Click"/>
            </StackPanel>

            <!-- Find by surname section -->
            <TextBlock Text="Find by surname" Margin="0,0,0,2" DockPanel.Dock="Top"/>
            <TextBox x:Name="tbSurname" Margin="0,0,0,4" DockPanel.Dock="Top"
                     KeyDown="tbSurname_KeyDown"/>
            <Button x:Name="btnFindSurname" Content="Find" Width="60" HorizontalAlignment="Left"
                    Padding="4,2" Margin="0,0,0,20" DockPanel.Dock="Top"
                    Click="btnFindSurname_Click"/>

            <!-- Current MPs section -->
            <TextBlock Text="Current MPs" Margin="0,0,0,2" DockPanel.Dock="Top"/>
            <Button x:Name="btnCurrentMPs" Content="Fetch" Width="60" HorizontalAlignment="Left"
                    Padding="4,2" Margin="0,0,0,20" DockPanel.Dock="Top"
                    Click="btnCurrentMPs_Click"/>

            <!-- Language selector and query count at the bottom -->
            <ComboBox x:Name="cbLanguage" Margin="0,0,0,8" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Finnish" IsSelected="True"/>
                <ComboBoxItem Content="Swedish"/>
            </ComboBox>
            <TextBlock x:Name="lblHasMore" Text="Scroll down to find more"
                       Foreground="DarkRed" Margin="0,0,0,4"
                       IsVisible="False" DockPanel.Dock="Bottom"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" DockPanel.Dock="Bottom">
                <TextBlock Text="Amount of queries:" Margin="0,2,4,2" VerticalAlignment="Center"/>
                <TextBox x:Name="tbQueryCount" Text="50" Width="45"/>
            </StackPanel>
        </DockPanel>

        <!-- Data grid -->
        <DataGrid x:Name="dataGrid" Grid.Row="2" Grid.Column="1" Margin="5,10,10,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  CanUserSortColumns="True"
                  DoubleTapped="dataGrid_DoubleTapped"
                  Sorting="dataGrid_Sorting">
            <DataGrid.Styles>
                <!-- Base row style: white background, dark text so the Fluent dark theme doesn't bleed through -->
                <Style Selector="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                </Style>
                <!-- Alternating row stripe: soft blue-grey for easy scanning -->
                <Style Selector="DataGridRow:nth-child(2n)">
                    <Setter Property="Background" Value="#EEF2F7"/>
                </Style>
            </DataGrid.Styles>
        </DataGrid>
    </Grid>
</Window>
