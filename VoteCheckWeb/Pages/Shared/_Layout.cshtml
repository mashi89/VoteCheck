@{
    // Permalinks are the product's distribution mechanism (design.md §3), so every page
    // states its own title, description and canonical URL, and unfurls in a feed.
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = pageTitle != null ? pageTitle + " — Edustajavahti" : "Edustajavahti — Eduskunnan äänestykset";
    var description = ViewData["Description"] as string
        ?? "Miten kansanedustajat ovat äänestäneet? Selaa eduskunnan täysistuntoäänestyksiä, "
           + "puolueiden jakaumia ja edustajien äänestyskäyttäytymistä.";
    // Absolute URLs: og:url and canonical must not be relative, and a shared link may be
    // resolved by a crawler that never saw the originating request.
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:site_name" content="Edustajavahti" />
    <meta property="og:type" content="@(ViewData["OgType"] as string ?? "website")" />
    <meta property="og:title" content="@(ViewData["OgTitle"] as string ?? fullTitle)" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="fi_FI" />
    @* Summary rather than summary_large_image: there is no image, and asking for a large
       card without one renders as an empty box in most clients. *@
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@(ViewData["OgTitle"] as string ?? fullTitle)" />
    <meta name="twitter:description" content="@description" />

    @* asp-append-version fingerprints the URL from the file's content hash, so the edge and
       the browser can both cache it indefinitely and still pick up a change immediately. *@
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    @{
        // A section is current when the path is inside it, so /mp/1109 lights up
        // "Kansanedustajat" rather than nothing at all.
        var path = Context.Request.Path.Value ?? "/";
        string Current( params string[] prefixes ) =>
            prefixes.Any( p => path.StartsWith( p, StringComparison.OrdinalIgnoreCase ) )
                ? "page" : null!;
    }
    <header class="site-header">
        <nav aria-label="Sivuston osiot">
            <a class="brand" href="/">Edustajavahti</a>
            <a href="/mps" aria-current="@Current( "/mps", "/mp/" )">Kansanedustajat</a>
            <a href="/search" aria-current="@Current( "/search" )">Haku</a>
        </nav>
    </header>
    <main>
        @RenderBody()
    </main>
    @* Where the numbers come from, and how fresh they are. A site that asks people to check
       what their representative did has to be checkable itself. *@
    <footer class="site-footer">
        <p>
            Tiedot ovat peräisin eduskunnan avoimesta datasta
            (<a href="https://avoindata.eduskunta.fi/" rel="noopener">avoindata.eduskunta.fi</a>),
            ja ne haetaan rajapinnasta <code>api.eduskunta.fi</code>. Palvelu pitää omaa kopiota
            aineistosta, joten uusin äänestys voi näkyä tässä pienellä viiveellä.
        </p>
        <p>
            Edustajavahti ei ole eduskunnan palvelu.
            <a href="https://github.com/mashi89/VoteCheck" rel="noopener">Lähdekoodi GitHubissa</a>.
        </p>
    </footer>
</body>
</html>
