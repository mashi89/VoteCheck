@page
@model IndexModel

@{
    ViewData["Description"] =
        "Miten kansanedustajat ovat äänestäneet? Selaa eduskunnan viimeisimpiä "
        + "täysistuntoäänestyksiä ja katso, miten oma edustajasi äänesti.";
}

<h1 class="page-title">Viimeisimmät äänestykset</h1>

<form class="search" action="/search" method="get" role="search">
    <label class="visually-hidden" for="q">Hae äänestyksiä aiheella</label>
    <input id="q" type="search" name="query" placeholder="Hae äänestyksiä aiheella…" />
    <button type="submit">Hae</button>
</form>

@if ( Model.Sessions.Count == 0 ) {
    <p class="empty">
        Tietokanta on tyhjä — äänestyksiä haetaan parhaillaan eduskunnan avoimen datan
        rajapinnasta. Päivitä sivu hetken kuluttua.
    </p>
} else {
    <ol class="divisions">
        @foreach ( var s in Model.Sessions ) {
            <partial name="_Division" model="s" />
        }
    </ol>
}
