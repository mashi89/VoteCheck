@page "/mp/{personNumber:int}"
@using System.Globalization
@model MpModel

@if ( Model.Profile == null ) {
    <h1 class="page-title">Edustajaa ei löytynyt</h1>
    <p>Tarkista osoite tai <a href="/mps">selaa kansanedustajia</a>.</p>
    return;
}

@{
    var mp = Model.Profile.Mp;
    var activity = Model.Activity;
    var attendance = Model.Profile.TotalVotes > 0
        ? 100.0 * Model.Profile.Present / Model.Profile.TotalVotes
        : 0;

    ViewData["Title"] = $"{mp.FirstName} {mp.LastName}";
    ViewData["OgType"] = "profile";
    ViewData["OgTitle"] = $"{mp.FirstName} {mp.LastName} ({Party.Name( mp.Party )}) — Edustajavahti";
    ViewData["Description"] = Model.Profile.TotalVotes > 0
        ? $"{mp.FirstName} {mp.LastName} ({Party.Name( mp.Party )}): {Model.Profile.TotalVotes} äänestystä, "
          + $"läsnäolo {Format.Percent( attendance )} %. Katso edustajan äänet eduskunnassa."
        : $"{mp.FirstName} {mp.LastName} ({Party.Name( mp.Party )}) — ei äänestyksiä tietokannassa.";

    string Width( int n ) =>
        ( activity == null || activity.TotalVotes == 0 ? 0 : 100.0 * n / activity.TotalVotes )
            .ToString( "0.###", CultureInfo.InvariantCulture ) + "%";
}

<p class="eyebrow">
    <span title="@Party.FormalName( mp.Party )">@Party.Name( mp.Party )</span>
</p>
<h1 class="page-title">@mp.FirstName @mp.LastName</h1>

@if ( Model.Profile.TotalVotes == 0 ) {
    <p class="empty">Tästä edustajasta ei ole äänestyksiä tietokannassa.</p>
} else {
    <section class="outcome" aria-labelledby="aktiivisuus">
        <h2 id="aktiivisuus" class="visually-hidden">Äänestysaktiivisuus</h2>

        <div class="outcome-headline">
            <span class="verdict">Läsnä @Format.Percent( attendance ) %:ssa äänestyksistä</span>
            <span class="score">@Model.Profile.TotalVotes<span class="score-unit"> äänestystä</span></span>
        </div>

        @if ( activity != null ) {
            @* The same bar the vote page uses, so a member's record and a division's result
               are read the same way. Hidden from assistive technology because the list beside
               it states every number in words. *@
            <div class="tally-bar" aria-hidden="true">
                @if ( activity.Yes > 0 ) {
                    <span class="seg seg-jaa" style="width:@Width( activity.Yes )">@( activity.Yes * 8 > activity.TotalVotes ? activity.Yes.ToString() : "" )</span>
                }
                @if ( activity.No > 0 ) {
                    <span class="seg seg-ei" style="width:@Width( activity.No )">@( activity.No * 8 > activity.TotalVotes ? activity.No.ToString() : "" )</span>
                }
                @if ( activity.Blank > 0 ) { <span class="seg seg-neutral" style="width:@Width( activity.Blank )"></span> }
                @if ( activity.Absent > 0 ) { <span class="seg seg-absent" style="width:@Width( activity.Absent )"></span> }
            </div>

            <ul class="tally-key">
                <li><span class="swatch swatch-jaa"></span> Jaa <b>@activity.Yes</b></li>
                <li><span class="swatch swatch-ei"></span> Ei <b>@activity.No</b></li>
                <li><span class="swatch swatch-neutral"></span> Tyhjä <b>@activity.Blank</b></li>
                <li><span class="swatch swatch-absent"></span> Poissa <b>@activity.Absent</b></li>
            </ul>
        }
    </section>

    @* Said plainly: this is what the mirror holds, not a career total. *@
    <p class="asettelu">
        <span class="label">Mistä luvut kertovat</span>
        Luvut kattavat ne täysistuntoäänestykset, jotka ovat tässä palvelussa — eivät
        edustajan koko uraa. Mitätöidyt äänestykset on jätetty pois.
    </p>

    <h2>Viimeisimmät äänet</h2>
    <ol class="divisions divisions-compact">
        @foreach ( var v in Model.Profile.LatestVotes ) {
            <li class="division">
                <p class="eyebrow">
                    <time datetime="@Format.Iso( v.Date )">@Format.Date( v.Date )</time>
                    <span class="sep">·</span>
                    <span class="vote-@v.Vote">@v.Vote</span>
                </p>
                <h3 class="division-subject"><a href="/vote/@v.SessionId">@v.Title</a></h3>
            </li>
        }
    </ol>
}
