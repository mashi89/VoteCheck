@page "/search"
@model SearchModel

@{
    var hasQuery = !string.IsNullOrWhiteSpace( Model.Query );
    if ( hasQuery ) {
        ViewData["Title"] = $"Haku: {Model.Query}";
        ViewData["Description"] = $"Hakutulokset haulle ”{Model.Query}” eduskunnan äänestyksistä.";
    } else {
        ViewData["Title"] = "Haku";
        ViewData["Description"] = "Hae eduskunnan täysistuntoäänestyksiä aiheen tai asian mukaan.";
    }
}

<h1 class="page-title">Haku</h1>

<form class="search" method="get" role="search">
    <label class="visually-hidden" for="query">Hae äänestyksiä aiheella</label>
    <input id="query" type="search" name="query" value="@Model.Query"
           placeholder="Hae äänestyksiä aiheella…" autofocus />
    <button type="submit">Hae</button>
</form>

@if ( hasQuery ) {
    if ( Model.Sessions.Count == 0 ) {
        @* An empty result is a place to say what to do next, not just that there is nothing. *@
        <p class="empty">
            Haku ”@Model.Query” ei osunut yhteenkään äänestykseen. Kokeile lyhyempää sanaa tai
            asian nimeä — haku kohdistuu äänestysten otsikoihin ja aiheisiin.
        </p>
    } else {
        <p class="muted result-count">
            @Model.Sessions.Count tulosta haulle ”@Model.Query”
        </p>
        <ol class="divisions">
            @foreach ( var s in Model.Sessions ) {
                <partial name="_Division" model="s" />
            }
        </ol>
    }
}
