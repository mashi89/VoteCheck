@page "/search"
@model SearchModel

@{
    if ( !string.IsNullOrWhiteSpace( Model.Query ) ) {
        ViewData["Title"] = $"Haku: {Model.Query}";
        ViewData["Description"] = $"Hakutulokset haulle \"{Model.Query}\" eduskunnan äänestyksistä.";
    } else {
        ViewData["Title"] = "Haku";
        ViewData["Description"] = "Hae eduskunnan täysistuntoäänestyksiä aiheen tai asian mukaan.";
    }
}

<h1>Haku</h1>
<form class="search" method="get">
    <input type="search" name="query" value="@Model.Query" placeholder="Hae äänestyksiä aiheella…" />
    <button type="submit">Hae</button>
</form>

@if ( !string.IsNullOrWhiteSpace( Model.Query ) ) {
    <p class="muted">@Model.Sessions.Count tulosta haulle ”@Model.Query”</p>
    <table>
        <thead><tr><th>Pvm</th><th>Äänestys</th><th>Jaa</th><th>Ei</th></tr></thead>
        <tbody>
        @foreach ( var s in Model.Sessions ) {
            <tr>
                <td class="date">@s.Date[..Math.Min( 10, s.Date.Length )]</td>
                <td>
                    <a href="/vote/@s.Id">@s.Title</a><br />
                    <span class="muted"><span class="label">Aihe:</span> @s.Subject</span>
                </td>
                <td class="vote-Jaa">@s.Yes</td>
                <td class="vote-Ei">@s.No</td>
            </tr>
        }
        </tbody>
    </table>
}
